# Example only. Copy to .env for local use; never commit .env.
# Development uses Vite :5173 -> Node API :3001. Production defaults to PORT=3000.
PORT=3001
NODE_ENV=development
ADMIN_USER=admin
# Only used when the database has no admin; change the password in Admin > Account.
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
# Generate a different random secret for production (32+ characters).
SESSION_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
# MongoDB Atlas (or a local MongoDB replica set). URL-encode special characters in passwords.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ice_cold
# If behind one trusted HTTPS reverse proxy; default in production is 1.
# TRUST_PROXY=1
